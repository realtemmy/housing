// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LeaseStatus {
  PENDING // Created, waiting for payment/signature
  ACTIVE // Paid and currently living there
  TERMINATED // Ended early (eviction or break)
  EXPIRED // Contract time ended normally
  CANCELLED // Never started
}

enum PaymentFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
  BI_ANNUALLY //6 months
}

model Tenant {
  id     String @id @default(uuid())
  userId String @unique

  emergencyContact String?
  metadata         Json? // Store background check results, etc.

  leases Lease[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lease {
  id       String @id @default(uuid())
  unitId   String
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  actualMoveInDate  DateTime? // When they actually picked up keys/ commencement date
  actualMoveOutDate DateTime?

  // FINANCIALS (Use Decimal for money, never Float!)
  rentAmount       Decimal          @db.Decimal(10, 2)
  securityDeposit  Decimal          @default(0) @db.Decimal(10, 2)
  serviceCharge    Decimal          @default(0) @db.Decimal(10, 2) // Common in serviced estates
  totalAmount      Decimal          @db.Decimal(10, 2)
  paymentFrequency PaymentFrequency @default(YEARLY)
  status           LeaseStatus      @default(PENDING)

  // DOCUMENTS
  agreementUrl      String? // PDF link to the signed lease
  terminationReason String?
  terminationDate   DateTime?

  renewals LeaseRenewal[]
  payments LeasePayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([unitId])
  @@index([status])
}

model LeaseRenewal {
  id String @id @default(uuid())

  leaseId String
  lease   Lease  @relation(fields: [leaseId], references: [id])

  requestedAt DateTime @default(now())
  newStart    DateTime
  newEnd      DateTime
  newRent     Decimal? @db.Decimal(10, 2)

  approved Boolean @default(true)
  notes    String?
}

model LeasePayment {
  id      String @id @default(uuid())
  leaseId String
  lease   Lease  @relation(fields: [leaseId], references: [id])

  amount    Decimal  @db.Decimal(10, 2)
  paidAt    DateTime @default(now())
  reference String // Payment Gateway Reference (Paystack/Flutterwave)
  status    String // SUCCESS, FAILED
}
