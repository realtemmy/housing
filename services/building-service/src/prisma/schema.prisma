// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UnitType {
  APARTMENT
  HOUSE
  HOSTEL
  HOTEL
  STUDIO
}

enum AvailableStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  CLOSED
}

model Property {
  id          String  @id @default(uuid())
  title       String
  description String?

  // Ownership and management
  ownerId     String

  // Verification and status
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt DateTime?
  verifiedBy String? // ID of verifier (user or system)
  verificationNotes String?

  // Status flags
  isActive Boolean @default(true)

  // Listing information
  listingTitle String?
  listingDescription String?
  listingStatus ListingStatus @default(DRAFT)
  listingViews Int @default(0)
  isFeatured Boolean @default(false)
  virtualTourUrl String?
  amenities Json?

  // Geographic information
  address Address?

  // Financial information (using Decimal for currency precision)
  purchasePrice Decimal? @db.Decimal(15, 2)
  currentValue Decimal? @db.Decimal(15, 2)

  // Timestamps for tracking
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?  // Soft delete

  // Audit trail
  createdBy String?
  updatedBy String?

  // Relationships
  buildings Building[] @relation("PropertyBuildings")
  units Unit[]
  rooms Room[]
  beds Bed[]

  // Indexes for query performance
  @@index([ownerId])
  @@index([verificationStatus])
  @@index([isActive])
  @@index([deletedAt])
  @@index([listingStatus])
}

model Building {
  id          String  @id @default(uuid())
  name        String
  description String?
  summary     String?

  // Ownership and relationships
  property   Property @relation("PropertyBuildings", fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String

  // Geographic information (optional, inherits from property if not set)
  address Address?

  // Building details
  floors Int?

  // Status and verification
  verified Boolean @default(false)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?  // Soft delete

  // Audit trail
  createdBy String?
  updatedBy String?

  // Relationships
  units Unit[] // cascade on delete

  // Indexes
  @@index([propertyId])
  @@index([deletedAt])
}

model Address {
  id         String @id @default(uuid())
  street     String
  city       String
  state      String
  postalCode String
  country    String
  longitude  Float?
  latitude   Float?

  // Relationship to building (optional - address can exist without building initially)
  building   Building? @relation(fields: [buildingId], references: [id])
  buildingId String? @unique

  // For properties without buildings (land-only listings)
  property   Property? @relation(fields: [propertyId], references: [id])
  propertyId String? @unique

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@index([buildingId])
  @@index([propertyId])
}

model Unit {
  id         String   @id @default(uuid())
  unitNumber String
  summary    String?
  type       UnitType @default(APARTMENT)

  // Physical details
  floor     Int?
  bedrooms  Int?
  bathrooms Int?
  sqft      Int?

  // Financial information (using Decimal for currency precision)
  rentAmount    Decimal? @db.Decimal(10, 2)
  depositAmount Decimal? @db.Decimal(10, 2)

  // Status and availability
  status        AvailableStatus @default(AVAILABLE)
  occupantId    String?

  // Listing information
  listingTitle String?
  listingDescription String?
  listingStatus ListingStatus @default(DRAFT)
  listingViews Int @default(0)
  isFeatured Boolean @default(false)
  virtualTourUrl String?
  amenities Json?

  // Tracking dates
  initializedAt DateTime?
  reservedAt    DateTime?
  reservedUntil DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?  // Soft delete

  // Audit trail
  createdBy String?
  updatedBy String?

  // Relationships
  building   Building @relation(fields: [buildingId], references: [id])
  buildingId String

  property   Property @relation(fields: [propertyId], references: [id])
  propertyId String

  maintenance MaintenanceRequest[]
  photos      Photo[]

  rooms Room[]

  // Indexes
  @@unique([buildingId, unitNumber])
  @@index([propertyId])
  @@index([buildingId])
  @@index([status])
  @@index([deletedAt])
  @@index([listingStatus])
}

model Room {
  id          String  @id @default(uuid())
  name        String
  description String?
  summary     String?
  size        Int?
  type        String? // Dorm, Male, Female, standard, suite, studio etc

  // Financial information (using Decimal for currency precision)
  rentAmount    Decimal? @db.Decimal(10, 2)
  depositAmount Decimal? @db.Decimal(10, 2)
  status        AvailableStatus @default(AVAILABLE)
  occupantId    String?

  // Listing information
  listingTitle String?
  listingDescription String?
  listingStatus ListingStatus @default(DRAFT)
  listingViews Int @default(0)
  isFeatured Boolean @default(false)
  virtualTourUrl String?
  amenities Json?

  // Tracking dates
  initializedAt DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?  // Soft delete

  // Audit trail
  createdBy String?
  updatedBy String?

  // Relationships
  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id])

  beds Bed[]

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  reservedAt    DateTime?
  reservedUntil DateTime?

  // Indexes
  @@unique([unitId, name])
  @@index([propertyId])
  @@index([unitId])
  @@index([deletedAt])
  @@index([listingStatus])
}

model Bed {
  id    String @id @default(uuid())
  label String // e.g., "Bed 1", "Top Bunk", "Window Side"

  // Financial information (using Decimal for currency precision)
  rentAmount    Decimal @db.Decimal(10, 2)
  depositAmount Decimal? @db.Decimal(10, 2)
  status        AvailableStatus @default(AVAILABLE)
  occupantId    String?

  // Listing information
  listingTitle String?
  listingDescription String?
  listingStatus ListingStatus @default(DRAFT)
  listingViews Int @default(0)
  isFeatured Boolean @default(false)
  virtualTourUrl String?
  amenities Json?

  // Tracking dates
  initializedAt DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?  // Soft delete

  // Audit trail
  createdBy String?
  updatedBy String?

  // Relationships
  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  reservedAt    DateTime?
  reservedUntil DateTime?

  // Indexes
  @@index([propertyId])
  @@index([roomId])
  @@index([deletedAt])
  @@index([listingStatus])
}

model Photo {
  id      String  @id @default(uuid())
  url     String
  caption String?

  // Relationships (optional - photo can exist without unit initially)
  unit   Unit?   @relation(fields: [unitId], references: [id])
  unitId String?

  // Timestamps
  createdAt DateTime @default(now())

  // Indexes
  @@index([unitId])
}

model MaintenanceRequest {
  id          String  @id @default(uuid())
  title       String
  description String?

  // Relationships
  unit   Unit   @relation(fields: [unitId], references: [id])
  unitId String

  requesterId String
  assigneeId  String

  // Status and priority
  status   MaintenanceStatus @default(OPEN)
  priority Int?

  // Timestamps
  requestedAt DateTime  @default(now())
  resolvedAt  DateTime?

  // Relationships
  attachments Attachment[]
  notes       MaintenanceNote[]

  // Timestamps for record keeping
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@index([requesterId])
  @@index([assigneeId])
}

model MaintenanceNote {
  id        String             @id @default(uuid())
  request   MaintenanceRequest @relation(fields: [requestId], references: [id])
  requestId String

  authorId String
  body     String

  createdAt DateTime @default(now())
}

model Attachment {
  id       String  @id @default(uuid())
  url      String
  filename String?
  mimeType String?
  size     Int?

  uploadedById  String
  maintenance   MaintenanceRequest? @relation(fields: [maintenanceId], references: [id])
  maintenanceId String?

  createdAt DateTime @default(now())
}