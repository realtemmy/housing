// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BuildingType {
  APARTMENT
  HOUSE
  HOSTEL
}

enum UnitStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

model Property {
  id          String    @id @default(uuid())
  title       String
  description String?
  ownerId     String

  buildings   Building[]

  verified    Boolean   @default(false)
  isActive    Boolean   @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Building {
  id         String    @id @default(uuid())
  name       String

  property   Property  @relation(fields: [propertyId], references: [id])
  propertyId String

  // One-to-one optional relation to Address
  address     Address?

  type        BuildingType

  floors      Int?
  units       Unit[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Address {
  id         String   @id @default(uuid())
  street     String
  city       String
  state      String
  postalCode String
  country    String
  longitude  Float?
  latitude   Float?

  // Address belongs to one building
  building   Building @relation(fields: [buildingId], references: [id])
  buildingId String   @unique
}

model Unit {
  id            String         @id @default(uuid())
  unitNumber    String
  floor         Int?
  bedrooms      Int?
  bathrooms     Float?
  sqft          Int?
  status        UnitStatus     @default(AVAILABLE)
  rentAmount    Float
  depositAmount Float?

  type          String         // e.g. "studio", "1-bedroom", etc.

  // Relations
  building      Building       @relation(fields: [buildingId], references: [id])
  buildingId    String

  maintenance   MaintenanceRequest[]
  photos        Photo[]

  occupantId    String?         // optional user id of occupant

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([buildingId, unitNumber])
}

model Photo {
  id        String  @id @default(uuid())
  url       String
  caption   String?

  unit      Unit?   @relation(fields: [unitId], references: [id])
  unitId    String?

  createdAt DateTime @default(now())
}

model MaintenanceRequest {
  id          String            @id @default(uuid())
  title       String
  description String?

  unit        Unit              @relation(fields: [unitId], references: [id])
  unitId      String

  requesterId String
  assigneeId  String

  status      MaintenanceStatus @default(OPEN)
  priority    Int?

  requestedAt DateTime          @default(now())
  resolvedAt  DateTime?

  attachments Attachment[]
  notes       MaintenanceNote[]

  @@index([requesterId])
  @@index([assigneeId])
}

model MaintenanceNote {
  id        String             @id @default(uuid())
  request   MaintenanceRequest @relation(fields: [requestId], references: [id])
  requestId String

  authorId  String
  body      String

  createdAt DateTime           @default(now())
}

model Attachment {
  id            String              @id @default(uuid())
  url           String
  filename      String?
  mimeType      String?
  size          Int?

  uploadedById  String
  maintenance   MaintenanceRequest? @relation(fields: [maintenanceId], references: [id])
  maintenanceId String?

  createdAt     DateTime            @default(now())
}
