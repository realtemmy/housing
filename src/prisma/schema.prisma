datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/schema"
}

// Enums
enum UserRole {
  ADMIN
  USER
}

enum PropertyType {
  APARTMENT
  HOUSE
  HOSTEL
}

enum UnitStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

enum LeaseStatus {
  ACTIVE
  PENDING
  TERMINATED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

// Models
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  phone        String?  @unique
  bio          String?
  photo        String?
  role         UserRole @default(USER)
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  properties          Property[]           @relation("UserProperties") // for landlords/managers
  unitsManaged        Unit[]               @relation("ManagerUnits")
  leases              Lease[]
  payments            Payment[]
  maintenanceReq      MaintenanceRequest[] @relation("Requester")
  assignedRequests    MaintenanceRequest[] @relation("Assignee")
  maintenanceRequests MaintenanceRequest[] @relation("UserMaintenance")
  notifications       Notification[]
  documents           Document[]
  property            Property?            @relation(fields: [propertyId], references: [id])
  propertyId          String?
  Tenant              Tenant?
  MaintenanceNote     MaintenanceNote[]
  Attachment          Attachment[]
  Unit                Unit[]
}

model Property {
  id          String       @id @default(uuid())
  title       String
  description String?
  type        PropertyType
  address     Address?
  owner       User         @relation(fields: [ownerId], references: [id], name: "UserProperties")
  ownerId     String
  buildings   Building[]
  units       Unit[]
  amenities   Amenity[]    @relation("PropertyAmenities")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  isActive    Boolean      @default(true)
  User        User[]
}

model Building {
  id         String   @id @default(uuid())
  property   Property @relation(fields: [propertyId], references: [id])
  propertyId String
  name       String?
  floors     Int?
  units      Unit[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Address {
  id         String    @id @default(uuid())
  street     String
  city       String
  state      String
  postalCode String
  country    String
  property   Property? @relation(fields: [propertyId], references: [id])
  propertyId String?   @unique
}

model Unit {
  id            String     @id @default(uuid())
  unitNumber    String
  floor         Int?
  bedrooms      Int?
  bathrooms     Float?
  sqft          Int?
  status        UnitStatus @default(AVAILABLE)
  rentAmount    Float
  depositAmount Float?

  // relations
  property    Property             @relation(fields: [propertyId], references: [id])
  propertyId  String
  building    Building?            @relation(fields: [buildingId], references: [id])
  buildingId  String?
  leases      Lease[]
  maintenance MaintenanceRequest[]
  photos      Photo[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  user        User?                @relation(fields: [userId], references: [id])
  userId      String?
  userUnits   User[]               @relation("ManagerUnits")

  @@unique([propertyId, unitNumber])
}

model Tenant {
  // Optional: separate Tenant model if you want tenant-specific fields that differ from User
  id               String    @id @default(uuid())
  user             User      @relation(fields: [userId], references: [id])
  userId           String    @unique
  movedInAt        DateTime?
  movedOutAt       DateTime?
  emergencyContact String?
  metadata         Json?
}

model Lease {
  id              String         @id @default(uuid())
  unit            Unit           @relation(fields: [unitId], references: [id])
  unitId          String
  tenant          User           @relation(fields: [tenantId], references: [id])
  tenantId        String
  startDate       DateTime
  endDate         DateTime
  rentAmount      Float
  securityDeposit Float?
  status          LeaseStatus    @default(PENDING)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  payments        Payment[]
  invoices        Invoice[]
  renewals        LeaseRenewal[]

  @@index([tenantId])
  @@index([unitId])
}

model LeaseRenewal {
  id          String   @id @default(uuid())
  lease       Lease    @relation(fields: [leaseId], references: [id])
  leaseId     String
  requestedAt DateTime @default(now())
  newStart    DateTime
  newEnd      DateTime
  newRent     Float?
  approved    Boolean? @default(false)
}

model Payment {
  id             String        @id @default(uuid())
  lease          Lease?        @relation(fields: [leaseId], references: [id])
  leaseId        String?
  invoice        Invoice?      @relation(fields: [invoiceId], references: [id])
  invoiceId      String?
  payer          User          @relation(fields: [payerId], references: [id])
  payerId        String
  amount         Float
  currency       String        @default("USD")
  method         String?
  status         PaymentStatus @default(PENDING)
  transactionRef String?       @unique
  paidAt         DateTime?
  createdAt      DateTime      @default(now())

  @@index([payerId])
}

model Invoice {
  id          String        @id @default(uuid())
  lease       Lease?        @relation(fields: [leaseId], references: [id])
  leaseId     String?
  title       String
  description String?
  amount      Float
  dueDate     DateTime?
  status      PaymentStatus @default(PENDING)
  payments    Payment[]
  createdAt   DateTime      @default(now())
}

model MaintenanceRequest {
  id          String            @id @default(uuid())
  title       String
  description String?
  unit        Unit              @relation(fields: [unitId], references: [id])
  unitId      String
  requester   User              @relation("Requester", fields: [requesterId], references: [id])
  requesterId String
  assignee    User?             @relation("Assignee", fields: [assigneeId], references: [id])
  assigneeId  String?
  status      MaintenanceStatus @default(OPEN)
  priority    Int? // 1-5
  requestedAt DateTime          @default(now())
  resolvedAt  DateTime?
  attachments Attachment[]
  notes       MaintenanceNote[]
  relatedUser User?             @relation("UserMaintenance", fields: [userId], references: [id])
  userId      String?

  @@index([requesterId])
  @@index([assigneeId])
}

model MaintenanceNote {
  id        String             @id @default(uuid())
  request   MaintenanceRequest @relation(fields: [requestId], references: [id])
  requestId String
  author    User               @relation(fields: [authorId], references: [id])
  authorId  String
  body      String
  createdAt DateTime           @default(now())
}

model Attachment {
  id            String              @id @default(uuid())
  url           String
  filename      String?
  mimeType      String?
  size          Int?
  uploadedBy    User                @relation(fields: [uploadedById], references: [id])
  uploadedById  String
  maintenance   MaintenanceRequest? @relation(fields: [maintenanceId], references: [id])
  maintenanceId String?
  createdAt     DateTime            @default(now())
}

model Photo {
  id        String   @id @default(uuid())
  url       String
  caption   String?
  unit      Unit?    @relation(fields: [unitId], references: [id])
  unitId    String?
  createdAt DateTime @default(now())
}

model Amenity {
  id          String     @id @default(uuid())
  name        String
  description String?
  properties  Property[] @relation("PropertyAmenities")
}

model Document {
  id           String   @id @default(uuid())
  title        String
  url          String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedById String
  metadata     Json?
  createdAt    DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  title     String
  body      String?
  read      Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())
}
